# =====================================================================
# Securities & Trading Firm RDI Demo — environment overrides.
#
# Copy to `.env` (same directory) and edit values. Docker Compose
# auto-loads `.env` from the project root and substitutes the values
# into docker-compose.yml at `docker compose up` time — so anything set
# here survives `./scripts/teardown.sh && ./scripts/setup.sh` and host
# reboots.
#
# Without a `.env` the demo uses the bake-in defaults in
# scripts/bootstrap-re.sh (4 GiB target / 512 MiB RDI state), which is
# the README §"Scale & measured performance" sweet spot for a 12 GB
# Docker Desktop laptop.
# =====================================================================

# ---- Target BDB (portfolio-cache, port 12000) ------------------------
# Holds the cached customer JSONs, FT cust-idx + hold-idx, security
# master, market prices. This is where the seeder writes at scale.
#
# Sizing table from README §"How far can you push it on the same laptop?"
#   Docker slider  →  TARGET_MEM_BYTES  →  max customers
#   12 GiB         →  4294967296        →  3,000,000 (default)
#   16 GiB         →  6442450944        →  5,000,000
#   20 GiB         →  8589934592        →  7,000,000
#   24 GiB         →  10737418240       →  9,000,000
#
# Raise Docker Desktop's memory slider BEFORE raising this number;
# Redis Enterprise reserves ~2× the BDB size as cluster provisional
# headroom, so a 6 GiB BDB needs ~13.5 GiB cluster RAM available.
TARGET_MEM_BYTES=4294967296

# ---- RDI state BDB (rdi-state, port 12001) ---------------------------
# CDC streams + pipeline state. 512 MiB is plenty for the demo workload
# (a few hundred MiB of streams at most). Only raise this if you
# generate sustained backpressure with multi-million-row replays.
RDI_MEM_BYTES=536870912
